{
  "name": "hanashofiyah-batch1-mobile-testing",
  "version": "1.0.0",
  "description": "Advanced Mobile Testing with Appium - Sauce Labs Demo App",
  "type": "module",
  "scripts": {
    "test": "wdio run ./wdio.conf.js",
    "test:login": "wdio run ./wdio.conf.js --spec ./test/specs/login.spec.js",
    "test:sorting": "wdio run ./wdio.conf.js --spec ./test/specs/sorting.spec.js",
    "test:logout": "wdio run ./wdio.conf.js --spec ./test/specs/logout.spec.js",
    "allure:clean": "node -e \"const fs=require('node:fs'); for (const p of ['reports/allure-results','reports/allure-report']) fs.rmSync(p,{recursive:true,force:true})\"",
    "allure:generate": "allure generate reports/allure-results -o reports/allure-report --clean",
    "allure:open": "allure serve reports/allure-results",
    "allure": "npm run allure:clean && npm test && npm run allure:generate && npm run allure:open"
  },
  "keywords": [
    "appium",
    "webdriverio",
    "mobile-testing",
    "allure"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@wdio/cli": "^9.29.0"
  },
  "devDependencies": {
    "@wdio/allure-reporter": "^9.32.0",
    "@wdio/appium-service": "^9.29.0",
    "@wdio/local-runner": "^9.29.0",
    "@wdio/mocha-framework": "^9.29.0",
    "@wdio/spec-reporter": "^9.29.0",
    "allure-commandline": "^2.43.0",
    "appium-uiautomator2-driver": "^7.6.2"
  }
}